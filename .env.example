DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional: identify this client to arXiv more clearly.
# Replace the email with yours if you want arXiv admins to contact you about traffic.
ARXIV_USER_AGENT=AIArxivReader/0.1 (https://github.com/Rubii115/AIArxivReader; mailto:your_email@example.com)

# Optional: use OpenAI-compatible provider instead.
# AI_PROVIDER=openai
