AI_PROVIDER=iphy
IPHY_BASE_URL=https://chat.iphy.ac.cn/api/v1
IPHY_API_KEY=your_iphy_api_key_here
# Optional. Leave empty to let the app fetch the first available model from /models.
# IPHY_MODEL=

# Optional: identify this client to arXiv more clearly.
# Replace the email with yours if you want arXiv admins to contact you about traffic.
ARXIV_USER_AGENT=AIArxivReader/0.1 (https://github.com/Rubii115/AIArxivReader; mailto:your_email@example.com)

# Optional: use OpenAI instead.
# AI_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4.1-mini
